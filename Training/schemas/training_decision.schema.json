{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sts2-rl/training_decision.schema.json",
  "title": "STS2 RL Training Decision Row",
  "type": "object",
  "required": [
    "export_version",
    "dataset_kind",
    "split",
    "trajectory_id",
    "scenario_id",
    "decision_id",
    "decision_index",
    "source_run_id",
    "source_combat_index",
    "observation",
    "legal_actions",
    "teacher_action",
    "teacher_action_type",
    "teacher_target",
    "candidate_actions",
    "combat_outcome",
    "termination_reason",
    "data_usage_classification",
    "truncation_classification",
    "emulator_commit",
    "emulator_dll_sha256",
    "heuristic_version"
  ],
  "properties": {
    "export_version": { "type": "string" },
    "dataset_kind": { "enum": ["complete", "partial"] },
    "split": { "enum": ["train", "validation", "test"] },
    "trajectory_id": { "type": "string" },
    "scenario_id": { "type": "string" },
    "decision_id": { "type": "string" },
    "decision_index": { "type": "integer", "minimum": 0 },
    "source_run_id": { "type": ["string", "integer"] },
    "source_combat_index": { "type": "integer", "minimum": 0 },
    "observation": { "type": "object" },
    "legal_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/normalizedAction" }
    },
    "teacher_action": { "$ref": "#/$defs/normalizedAction" },
    "teacher_action_type": { "type": ["string", "null"] },
    "teacher_target": {
      "type": "object",
      "required": ["selected_enemy_index", "selected_action_index"],
      "properties": {
        "selected_enemy_index": { "type": ["integer", "null"] },
        "selected_action_index": { "type": ["integer", "null"] }
      }
    },
    "teacher_score": { "type": ["number", "null"] },
    "candidate_actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidateAction" }
    },
    "combat_outcome": { "type": ["string", "null"] },
    "termination_reason": { "type": ["string", "null"] },
    "data_usage_classification": { "type": ["string", "null"] },
    "truncation_classification": { "type": ["string", "null"] },
    "emulator_commit": { "type": ["string", "null"] },
    "emulator_dll_sha256": { "type": ["string", "null"] },
    "heuristic_version": { "type": ["string", "null"] },
    "raw_next_state": { "type": ["object", "null"] }
  },
  "$defs": {
    "normalizedAction": {
      "type": "object",
      "required": [
        "action_id",
        "action_type",
        "label",
        "is_available",
        "card_id",
        "potion_id",
        "target_type",
        "target_enemy_index",
        "raw_parameters",
        "action_id_scope"
      ],
      "properties": {
        "action_id": { "type": ["integer", "string", "null"] },
        "action_type": { "type": ["string", "null"] },
        "label": { "type": ["string", "null"] },
        "is_available": { "type": ["boolean", "null"] },
        "card_id": { "type": ["string", "null"] },
        "potion_id": { "type": ["string", "null"] },
        "target_type": { "type": ["string", "null"] },
        "target_enemy_index": { "type": ["integer", "null"] },
        "raw_parameters": { "type": "object" },
        "action_id_scope": { "const": "state_local_ephemeral" }
      }
    },
    "candidateAction": {
      "type": "object",
      "required": [
        "action_id",
        "label",
        "target_index",
        "enemy_index",
        "score",
        "skipped_reason",
        "exception_type",
        "exception_message"
      ],
      "properties": {
        "action_id": { "type": ["integer", "string", "null"] },
        "label": { "type": ["string", "null"] },
        "target_index": { "type": ["integer", "null"] },
        "enemy_index": { "type": ["integer", "null"] },
        "score": { "type": ["number", "null"] },
        "skipped_reason": { "type": ["string", "null"] },
        "exception_type": { "type": ["string", "null"] },
        "exception_message": { "type": ["string", "null"] }
      }
    }
  }
}

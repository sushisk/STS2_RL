%% 責任主体: Main Process
%% 参照上位図: mermaid_rough_combat.mermaid (MAIN_PROCESS subgraph)
%% 目的: Mainが常に「採用済みSequenceの実行のみ」を行うこと、Decision Result(StartCombat/Step/
%%       RestoreのいずれかがまとめてBoundary・Observation・Choice候補・Terminal/Fault・metadataを
%%       返す一括戻り値)のみをdecision情報源とし、GetObservation/GetLegalActionsで別途読み直さない
%%       ことを明示する。あわせてMain自身のPending時Replay Prefix管理、Step成功ごとの
%%       (Semantic Action, Observed Post-Step Signature)記録追加、およびMain-observed Pending
%%       (Replay Prefix非空)からの新規decisionを静的評価(PENDING_STATIC)に制限することを定義する。
%%       例外: Start-of-Combat Pending(TOOLBOX/CHOICES_PARADOX/GAMBLING_CHIP等、
%%       held_stable_snapshot is Noneの場合)は2026-08-03よりこの制限から外れ、Combat Start
%%       Replay Root経由でSearch Coordinatorへの通常の探索対象となる(→ NOTE_PENDING_FUTURE、
%%       NEED_SEARCH_COMBAT_START)。Held Stable Snapshotとして扱われることは一切ない
%%       (→ NOTE_NO_HELD_SNAPSHOT_AT_GENESIS)。
flowchart TD
    ENTRY["Combat Entry<br/>(mermaid_combat.mermaidのENTRANCE群から接続)"] --> MAIN_INST

    subgraph MAIN["Main Process (責任: Main GameInstanceの正本を保持)"]
        MAIN_INST["Main GameInstance<br/>実際のCombat状態を保持<br/>このInstanceは仮説評価では一切変更されない"]
        MAIN_INST --> CUR_RESULT["Current Decision Resultを保持<br/>(StartCombat／Restore／直前StepのいずれかがまとめてBoundary・<br/>Observation・Choice候補・Choice種別/scope/制約・Terminal/Fault・<br/>CombatSessionId/StepIndex等を返した一括戻り値)<br/>※GetObservation／GetLegalActionsでの再取得は行わない"]

        CUR_RESULT --> BOUNDARY{"Current ResultのBoundary"}

        BOUNDARY -->|"Terminal"| END["Combat終了<br/>CombatResultを確定"]
        BOUNDARY -->|"Fault"| FAULT_OUT["Main Combat Fault<br/>詳細: mermaid_combat_fault_worker_detail.mermaid"]

        BOUNDARY -->|"Stable"| STABLE_CAPTURE["CaptureSnapshot<br/>(Emulator API境界)<br/>Held Stable Snapshotとして保持し<br/>Replay Prefix = 空にリセット<br/>(次のStepを行う前に必ず再現元を確保する)"]
        BOUNDARY -->|"Pending"| PENDING_HOLD["Held Stable Snapshot・Replay Prefixは<br/>直前のStable到達時のまま変更せず保持継続<br/>(Pending自体はCaptureしない)。<br/>Start-of-Combat Pending(まだ一度もStableに到達していない=<br/>held_stable_snapshot is Noneの場合)は、この時点でCombat Start Replay Root<br/>(このCombat開始に使ったScenario／RNG Seed／Deck／Relic)を確定するのみで、<br/>Held Stable Snapshotには一切書き込まない(→ 下記NOTE_NO_HELD_SNAPSHOT_AT_GENESIS)"]

        STABLE_CAPTURE --> MAIN_DC["Main Decision Context確定:<br/>Held Stable Snapshot＋Replay Prefix(空)＋Current Result"]
        PENDING_HOLD --> MAIN_DC2["Main Decision Context確定:<br/>Held Stable Snapshot(直前分)＋Replay Prefix(Stableから現在まで、<br/>各エントリは(Semantic Action, Observed Post-Step Signature))＋<br/>Current Result(直前StepのPending Choice Payload)<br/>(Start-of-Combat Pendingの場合はHeld Stable Snapshotの代わりに<br/>Combat Start Replay Rootを用いる<br/>→ mermaid_combat_snapshot_replay_detail.mermaidのDC_COMBAT_START)"]

        MAIN_DC --> SEQ_HAS_S{"採用中のPlanned Sequenceが残っているか"}
        MAIN_DC2 --> SEQ_HAS_P{"採用中のPlanned Sequenceが残っているか"}

        SEQ_HAS_S -->|"Yes"| SEQ_STEP["Sequence継続実行へ (下記EXEC_LOOP)"]
        SEQ_HAS_P -->|"Yes"| SEQ_STEP

        SEQ_HAS_S -->|"No"| NEW_DECISION{"新しいdecisionの決定方法<br/>(Stable起点。RNG Hypothesisを新規に検討可能)"}
        SEQ_HAS_P -->|"No"| NEW_DECISION_PENDING{"新しいdecisionの決定方法<br/>(Pending起点。Replay Prefix非空につき制限あり。<br/>ただしStart-of-Combat Pending(held_stable_snapshot is None)は例外<br/>→ 下記NEED_SEARCH_COMBAT_START)"}

        NEW_DECISION -->|"Direct<br/>候補評価不要"| DIRECT["Current Decision Resultの候補から<br/>Semantic Actionを直接1つ選択<br/>(Planned Sequence長=1、Expected Post-Step Signatureは付与しない<br/>=自己決定であり事前検証対象ではない)"]
        NEW_DECISION -->|"候補評価が必要<br/>Heuristic1段 or Beam Search"| NEED_SEARCH["Search CoordinatorへMain Decision Contextを渡す<br/>(Held Stable Snapshot＋Replay Prefix(空)＋Current Result。<br/>この時点のCurrent Result由来のシグネチャがCurrent Context Signatureとして<br/>Search Coordinator側に記録される)"]

        NEW_DECISION_PENDING -->|"Direct<br/>候補評価不要"| DIRECT
        NEW_DECISION_PENDING -->|"静的評価のみ<br/>(mid-combatのMain-observed Pending。候補評価が必要な場合でも<br/>探索的Lookaheadは行わない — 下記NOTE_PENDING_FUTURE参照)"| PENDING_STATIC["mermaid_combat_candidate_pipeline_detail.mermaidと同じ<br/>choice_kind別の軽量Evaluatorを、Current Decision Resultの<br/>候補へ直接適用し、最上位1件を選択<br/>(Restore／Step／Worker分岐は一切行わない。Search Coordinator/<br/>Branch Worker Poolへは一切送らない。実RNGのまま分岐探索して<br/>Evaluatorへ結果が見える事態を避けるための初期実装時点の安全策。<br/>この経路のEvaluatorにも、Authoritative OrderedDrawPile(Mainの真の状態)を<br/>そのまま渡さない(Order-Masked Observation(Hidden-Order Features。<br/>並び順を含まない集計特徴量)のみ)<br/>→ mermaid_combat_rng_hypothesis_detail.mermaidのBOUNDARY_TABLE、<br/>mermaid_combat_candidate_pipeline_detail.mermaidのNOTE_DRAWPILE_HIDDEN。<br/>Planned Sequence長=1、Expected Post-Step Signatureは付与しない)"]
        NEW_DECISION_PENDING -->|"候補評価が必要<br/>かつStart-of-Combat Pending<br/>(held_stable_snapshot is None、TOOLBOX/CHOICES_PARADOX/<br/>GAMBLING_CHIP等。2026-08-03追加 → 下記NOTE_PENDING_FUTURE)"| NEED_SEARCH_COMBAT_START["Search CoordinatorへCombat Start Replay Root起点の<br/>Decision Contextを渡す(Combat Start Replay Root＋Replay Prefix(空)＋<br/>Current Result。Held Stable Snapshotには一切書き込まない)"]

        DIRECT --> SET_SEQ["Planned Sequenceを確定<br/>(Semantic Action列＋各手のExpected Post-Step Signature。<br/>Direct／PENDING_STATICの場合はExpected Post-Step Signatureなし)"]
        PENDING_STATIC --> SET_SEQ
        NEED_SEARCH -.->|"Mainは変更しない<br/>Stableの場合のみCaptureSnapshotが必要になる可能性あり<br/>(既にSTABLE_CAPTUREで確保済みならRoot Snapshotとして再利用)"| TO_SEARCH["→ mermaid_combat_snapshot_replay_detail.mermaid<br/>Root Snapshot／Decision Context受け渡し"]
        NEED_SEARCH_COMBAT_START -.->|"Mainは変更しない(start_combat()の再実行は、Main自身のGameInstanceとは<br/>別のBranch Worker側GameInstanceで行う。Main自身のGameInstanceは<br/>このPendingに達したまま、Search完了後にMainがcommitした行動を<br/>実行するまで一切変更されない)"| TO_SEARCH
        TO_SEARCH -.->|"探索完了<br/>戻り値は SearchSuccess(PlannedSequence)<br/>または SearchEvaluationFailure のいずれか"| SEARCH_RESULT{"探索結果"}
        SEARCH_RESULT -->|"SearchSuccess<br/>(mermaid_combat_commit_detail.mermaidの方針により<br/>RNG Hypothesisが関与した場合は先頭1手のみ、<br/>かつExpected Post-Step Signatureなし)"| FROM_COMMIT["← mermaid_combat_commit_detail.mermaid<br/>COMMIT_SEQUENCE"]
        SEARCH_RESULT -->|"SearchEvaluationFailure<br/>(全候補がFault等で評価不能<br/>→ mermaid_combat_fault_worker_detail.mermaidのALL_FAULT)"| SEARCH_FAIL_HANDLE["SearchEvaluationFailureとして記録する<br/>(Main自身は正常であり、Main Combat Faultへは変換しない。<br/>Branch評価から採用可能な候補を得られなかっただけであり、<br/>Main GameInstance・State Identityは無傷。<br/>暗黙のDirect fallbackは行わない — Mainの決定方針の切替は<br/>上位の運用判断であり、本図では自動フォールバックしない)"]
        FROM_COMMIT --> SET_SEQ
        SEARCH_FAIL_HANDLE --> ABORT_POLICY{"上位層(呼び出し元/運用方針)の対応"}
        ABORT_POLICY -->|"現時点で定義済みの方針:<br/>この探索呼び出しを打ち切る"| COMBAT_ABORTED["CombatAbortedByDecisionFailure<br/>SearchEvaluationFailureを受け、上位方針によりこのCombatの<br/>決定継続を中止する(Main Combat Faultとも、計画通りの<br/>Combat終了(Terminal)とも異なる第三の終了種別として<br/>CombatResultへ記録する。将来的な再試行/代替方針の追加は<br/>本図の範囲外)"]

        subgraph EXEC_LOOP["採用Sequenceの連続実行 (Mainの同一live Instance上で継続)"]
            SET_SEQ --> RESOLVE["Planned Sequence先頭の未実行Semantic Actionを<br/>Current Decision Result／Choice Payloadの候補へ再解決"]
            SEQ_STEP --> RESOLVE
            RESOLVE --> RESOLVE_OK{"再解決できたか"}
            RESOLVE_OK -->|"No"| DISCARD["残りのPlanned Sequenceを破棄"]
            RESOLVE_OK -->|"Yes"| STEP["Main GameInstance.Stepを実行<br/>(Emulator API境界。1 Stepのみ)"]
            STEP --> STEP_RESULT["StepResultを受領し<br/>Current Decision Resultへ差し替える<br/>(GetObservation等の再取得は行わない)"]
            STEP_RESULT --> STEP_FAULT_CHECK{"StepResultのBoundaryはFaultか"}
            STEP_FAULT_CHECK -->|"Yes"| STEP_FAULT_JUMP["Transition Recordへは追記せず、<br/>Planned Sequenceの破棄/再同期も行わず、<br/>即座にMain Combat Faultへ遷移する<br/>(DISCARD/RESYNCの『通常の計画不一致』経路とは別物。<br/>Emulator側の実行時異常であり、再探索で解決する性質のものではない)"]
            STEP_FAULT_CHECK -->|"No"| APPEND_RECORD["成功したStepの(Semantic Action, Observed Post-Step Signature)を<br/>Main Decision ContextのReplay Prefixへ追記する"]
            APPEND_RECORD --> LOG["Action・StepResult(DecisionFrame相当)・RNG識別情報を<br/>RL生ログへ記録"]
            LOG --> VERIFY_TRANSITION{"想定した遷移と一致するか<br/>(この手のExpected Post-Step Signatureと比較。<br/>mermaid_combat_snapshot_replay_detail.mermaidのDC_SIGNATURE(軽量形式)を<br/>使用: 共通確認=State Identity(実行前後)・選択したSemantic ActionとActionId<br/>の対応・Emulatorが実際に解決したカード/対象/selection・到達したBoundary種別。<br/>Pendingの場合のみ追加でChoice scope・choice_kind・候補Semantic Key集合<br/>(canonical multiset)。HP/Block/Energy/Pile/Power/Relic/敵状態等の盤面期待値は<br/>作成せず判定に使わない(→ snapshot_replay_detailのNOTE_NO_BOARD_PREDICTION)。<br/>Direct／PENDING_STATIC、または(RNG Hypothesis由来のCOMMIT_FIRST_ONLYにより)<br/>Expected Post-Step Signatureが付与されていない場合は無条件で一致扱い<br/>= 不一致による誤ったDISCARDを起こさない)"}
            VERIFY_TRANSITION -->|"不一致"| DISCARD
            VERIFY_TRANSITION -->|"一致"| TERMINAL_CHECK{"Terminalか"}
            TERMINAL_CHECK -->|"Yes<br/>計画通りの終端"| CONSUME_END["Sequence実行を終了"]
            TERMINAL_CHECK -->|"No"| STEP_BOUNDARY{"このStepの到達Boundary(Stable／Pending)<br/>(Planned Sequenceに残りがあっても、<br/>この判定と直後のBoundary処理は毎Step必ず行う。<br/>Sequence完了まで遅延させない)"}
            STEP_BOUNDARY -->|"Stable"| STEP_STABLE_CAPTURE["CaptureSnapshot<br/>(Emulator API境界)<br/>Held Stable SnapshotをこのStepの結果で更新し、<br/>Main Decision ContextのReplay Prefixを空へリセットする"]
            STEP_BOUNDARY -->|"Pending"| STEP_PENDING_HOLD["Held Stable Snapshotは直前のStable到達時のまま維持する<br/>(このStep分のTransition Recordは既にAPPEND_RECORDで<br/>Replay Prefixへ追記済み。Pending自体はCaptureしない)"]
            STEP_STABLE_CAPTURE --> SEQ_REMAIN_S{"Planned Sequenceに残りがあるか"}
            STEP_PENDING_HOLD --> SEQ_REMAIN_P{"Planned Sequenceに残りがあるか"}
            SEQ_REMAIN_S -->|"Yes"| RESOLVE
            SEQ_REMAIN_P -->|"Yes"| RESOLVE
            SEQ_REMAIN_S -->|"No"| MAIN_DC
            SEQ_REMAIN_P -->|"No"| MAIN_DC2
        end

        DISCARD --> RESYNC["残りのPlanned Sequenceを破棄し、<br/>Current Decision Resultから通常の決定ループへ復帰<br/>(このStep自体はVERIFY_TRANSITION不一致によりSTEP_BOUNDARYを<br/>経ていないため、BOUNDARYへ戻り改めてStable／Pending処理を行う)"]
        RESYNC --> BOUNDARY
        CONSUME_END --> BOUNDARY
    end

    STEP_FAULT_JUMP --> FAULT_OUT

    FAULT_OUT --> RETURN
    COMBAT_ABORTED --> RETURN
    END --> RETURN["呼び出し元へCombatResultとRL生ログを返す"]

    %% 設計注記
    NOTE_MAIN["注記: MainはEXEC_LOOP(採用Sequence連続実行)以外の目的で<br/>Restore/Reset/Stepを行わない<br/>(参考: deprecated/mermaid_combat_target_worker_pool.mermaidのRULE_MAINと<br/>同趣旨。当該図は現在deprecatedであり、本方針は本図自体が正本として定義する)"]
    NOTE_MAIN -.-> STEP

    NOTE_DISCARD["設計注記: Planned Sequenceを破棄する(DISCARD/RESYNC経路)のは<br/>次の場合だけ:<br/>・Semantic Actionを現在のChoice Payloadへ解決できない<br/>・記録された想定Expected Post-Step Signatureと異なる<br/>・予定外のTerminalへ到達した<br/>・Mainの正本が探索開始時の前提から変化した<br/>StepResult自体がFaultの場合はこのDISCARD/RESYNC(通常の計画不一致)<br/>経路には含めない。STEP_FAULT_CHECKで検出され、Transition Recordへの<br/>追記より前に即座にMain Combat Faultへ遷移する<br/>(→ 下記NOTE_FAULT_FIRST／STEP_FAULT_JUMP)。<br/>StableになっただけでSequenceを終了することはなく、<br/>逆にSequenceが空になった時点でPendingであることも異常ではない<br/>(その場合はSTEP_BOUNDARY/SEQ_REMAIN_S/SEQ_REMAIN_P経由で<br/>MAIN_DC/MAIN_DC2から新しいdecisionを開始する)。"]
    NOTE_DISCARD -.-> VERIFY_TRANSITION

    NOTE_NO_BOARD_PREDICTION_MAIN["設計注記(RL安全性確認方針、2026-08-01): MainのVERIFY_TRANSITIONも含め、<br/>RL側は盤面(HP/Block/Energy/Pile/Power/Relic/敵状態等)を予測・再計算しない。<br/>Power/Relic/Hook/カード固有処理を含む戦闘結果はEmulatorの責任範囲であり、<br/>StepResultの報告値をそのまま信頼する<br/>(→ mermaid_combat_snapshot_replay_detail.mermaidのNOTE_NO_BOARD_PREDICTION、<br/>DC_SIGNATURE)。"]
    NOTE_NO_BOARD_PREDICTION_MAIN -.-> VERIFY_TRANSITION

    NOTE_NO_REREAD["設計注記: BOUNDARY判定・候補参照は常にCurrent Decision Result<br/>(StartCombat/Step/Restoreの戻り値)に基づく。GetObservation/<br/>GetLegalActionsによる別経路での状態再取得は行わない。"]
    NOTE_NO_REREAD -.-> CUR_RESULT

    NOTE_REPLAY_VS_PLAN["設計注記: MainのReplay Prefixは『直前のStableから現在までの<br/>再現用記録』であり、Stableに到達するたび空にリセットされる。<br/>Search CoordinatorがCommitまで保持する『Plan Path』<br/>(→ mermaid_combat_commit_detail.mermaid)とは別物であり、<br/>MainはPlan Pathを保持しない(受け取るのは既に確定したPlanned Sequenceのみ)。"]
    NOTE_REPLAY_VS_PLAN -.-> APPEND_RECORD

    NOTE_FAULT_FIRST["設計注記: StepResultがFaultの場合、Transition Recordへの追記<br/>(APPEND_RECORD)より前に判定し、即座にMain Combat Faultへ遷移する。<br/>Faultは『計画と実行結果が一致しない』という通常のDISCARD/RESYNC対象とは<br/>性質が異なり(Emulator側の実行時異常であり、Replay Prefix/Plan Pathへ<br/>記録して再現対象とすべきものではない)、再探索によって解決するものでもない。"]
    NOTE_FAULT_FIRST -.-> STEP_FAULT_CHECK

    NOTE_PENDING_FUTURE["設計注記: PENDING_STATICへの制限(探索的Lookahead不可・<br/>静的評価による1手選択のみ)は、最終的な機能方針ではなく、根本原因は<br/>『Pendingの再現手段が無いWorkerへどう到達させるか』という実装ギャップで<br/>あった。Start-of-Combat Pending(TOOLBOX/CHOICES_PARADOX/GAMBLING_CHIP等)は<br/>2026-08-03、Combat Start Replay Root(このCombat開始に使ったScenario／<br/>RNG Seed／Deck／Relic — CaptureされたSnapshotではない)という再現手段が<br/>整ったため、この制限から外れ、通常のSearch Coordinator経由の探索対象と<br/>なった(→ NEED_SEARCH_COMBAT_START、mermaid_combat_snapshot_replay_detail.<br/>mermaidのWHO_COMBAT_START/DC_COMBAT_START)。<br/>mid-combatのMain-observed Pending(Held Stable Snapshotが既に存在する<br/>状態でのAction Continuation Pending等)は、Pending自体を再現する<br/>Snapshot相当の手段がまだ無いため、引き続きPENDING_STATIC限定のままである。<br/>これは『choice_scope=ActionContinuationも原則探索対象である』という<br/>上位方針(→ mermaid_combat_candidate_pipeline_detail.mermaidの<br/>NOTE_KIND_VS_SCOPE)を撤回するものではない — Search自身は、あるDecision<br/>Context内でPending(Action Continuationの連鎖含む)へ到達した場合、<br/>Holder Worker継続／sibling Bootstrap+Replayで探索を継続する<br/>(→ mermaid_combat_branch_scheduler_detail.mermaidのLEASE_ESTABLISH/<br/>CONTEXT_UPDATE)。ここで言う制限は、あくまでMain自身が最初にPendingへ<br/>到達した時点でSearchへ入口として渡してよいか、という入口の話に限られる。"]
    NOTE_PENDING_FUTURE -.-> PENDING_STATIC
    NOTE_PENDING_FUTURE -.-> NEED_SEARCH_COMBAT_START

    NOTE_NO_HELD_SNAPSHOT_AT_GENESIS["設計注記(2026-08-03追加): Start-of-Combat Pendingは、たとえSearchの<br/>入口として使われても、Held Stable Snapshotとして保存・比較されることは<br/>一切ない。held_stable_snapshotはMainが本物のStable境界へ到達するまで<br/>Noneのままであり、Search呼び出し中もMain不変条件の検証は<br/>「held_stable_snapshotがNoneのまま」であることを確認する形に限る<br/>(Combat Start Replay Rootの内容とのdigest比較は行わない)。"]
    NOTE_NO_HELD_SNAPSHOT_AT_GENESIS -.-> PENDING_HOLD

    classDef api fill:#333,color:#fff,stroke:#000;
    class STEP api;

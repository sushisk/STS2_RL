%% 責任主体: Branch Worker (検出) + Search Coordinator (収集・方針決定) + Worker Management (プロセス管理) + Main Process (自身のFault)
%% 参照上位図: mermaid_rough_combat.mermaid (ROUGH_NOTE — 本図が「詳細図」に相当)
%% 目的: Restore拒否、Fault、Timeout、Continuation深さ上限、Worker再起動、評価不能Branchの処理、
%%       Fault種別ごとのWorker再利用可否(GameInstanceを信用してよいか)の判定、
%%       および「Search Evaluation Failure(全Branch評価不能)」と「Main Combat Fault(Main自身のFault)」の
%%       明確な区別を詳細化する
flowchart TD
    subgraph SOURCES["Faultの発生源(種別ごとに区別する)"]
        SRC_REJECT["validation rejection<br/>ValidateRestoreSnapshotJsonが不可と判定<br/>(mermaid_combat_snapshot_replay_detail.mermaid)"]
        SRC_REPLAY["replay mismatch<br/>Replay Prefix再生中の再解決不能／中間Signature不一致、<br/>またはCurrent Context Signature不一致<br/>(mermaid_combat_snapshot_replay_detail.mermaid)"]
        SRC_RESTORE_FAIL["post-teardown Restore failure<br/>RestoreSnapshotJson自体が例外(SnapshotRestoreFailedException等)"]
        SRC_ACTION["action fault<br/>候補Semantic ActionのStep自体がFault境界を返した<br/>(mermaid_combat_snapshot_replay_detail.mermaidのSTEP_FAULT_CHECK)"]
        SRC_TIMEOUT["WorkItemの処理がtask timeoutを超過"]
        SRC_PROC["Worker Processが異常終了<br/>(応答なし・クラッシュ)"]
        SRC_DEPTH["同一Decision Context系列内のContinuation連鎖回数が上限に到達<br/>(下記NOTE_DEPTH_CAP参照)"]
        SRC_NOCANDIDATE["候補パイプラインの枝刈り後に候補が0件<br/>(mermaid_combat_candidate_pipeline_detail.mermaid)"]
    end

    SRC_REJECT --> BRANCH_FAULT
    SRC_REPLAY --> BRANCH_FAULT
    SRC_RESTORE_FAIL --> BRANCH_FAULT
    SRC_ACTION --> BRANCH_FAULT
    SRC_DEPTH --> BRANCH_FAULT
    SRC_NOCANDIDATE --> BRANCH_FAULT

    subgraph WORKER["Branch Worker (責任: 自Branchの異常を検出・報告)"]
        BRANCH_FAULT["当該Branchをrejection/fault codeと<br/>再現に必要な情報(Snapshot参照・Sequence・原因)とともに<br/>Search Coordinatorへ返す"]
        BRANCH_FAULT --> FAULT_TYPE{"Fault種別ごとにGameInstanceを信用してよいか判定"}

        FAULT_TYPE -->|"validation rejection"| REUSE_SAFE["ValidateRestoreSnapshotJsonは非破壊的な照会であり、<br/>GameInstanceは一切変更されていない。<br/>同一WorkerをそのままReadyへ戻し再利用してよい(再起動不要)。"]
        FAULT_TYPE -->|"replay mismatch"| REUSE_UNKNOWN["Stepは実際に実行されており、GameInstanceは何らかの妥当な状態にはあるが、<br/>想定(Expected Post-Step Signature／Current Context Signature)と異なる。<br/>RestoreSnapshotJsonが次回呼び出し時に完全にクリーンな状態リセットを<br/>保証するかは未検証(GameInstanceがprocess-singleton stateであり、<br/>前セッションの完全なロールバックが保証されないという既存の知見がある)。<br/>安全側としてWorker再起動/強制再初期化を既定とする。"]
        FAULT_TYPE -->|"post-teardown Restore failure"| REUSE_UNSAFE["RestoreSnapshotJson自体が失敗した。GameInstanceを信用せず<br/>Workerをquarantineする。<br/>初期運用ではWorker Processを再起動する(運用ポリシーとしての既定)。<br/><br/>Emulator契約との区別: SnapshotRestoreFailedExceptionのdoc commentは<br/>『インポートされたランタイムはprocess-singleton stateのため<br/>前セッションをロールバックできない』と述べているが、これは<br/>そのRestore呼び出し自体の失敗を説明するものであり、Emulator契約上、<br/>その後の再度のRestore／Resetが成功すればGameInstanceが回復する<br/>可能性まで否定するものではない。現時点ではその回復可能性を<br/>実測検証していないため、安全側の運用ポリシーとして再起動を既定とする。<br/>性能上必要になった場合、決定性受け入れテストを追加した上で<br/>『clean Restore成功なら再利用』へ緩和を検討できる(未解決事項)。"]
        FAULT_TYPE -->|"action fault"| REUSE_CASE_BY_CASE["Emulator側で『既知の軽微な業務例外』として分類済みのFaultであれば<br/>再利用可能とみなせる可能性があるが、そのような分類基準は現時点で未確立。<br/>未分類/予期しない例外は安全側としてWorker再起動/強制再初期化を既定とする<br/>(Emulator側の例外分類整備後に緩和を検討する — 未解決事項)。"]

        REUSE_SAFE --> WORKER_READY_AGAIN["WorkerをReadyへ戻し次のWorkItemを受信可能にする"]
        REUSE_UNKNOWN --> FORCE_RESTART["Workerの強制再起動をWorker Managementへ要求"]
        REUSE_UNSAFE --> FORCE_RESTART
        REUSE_CASE_BY_CASE --> FORCE_RESTART
    end

    SRC_TIMEOUT --> WM_TIMEOUT_FORCE["Timeoutは既定でGameInstanceを信用しない<br/>(processがhealth probeに応答しても、中断された<br/>WorkItemがGameInstanceを中途半端な状態のまま<br/>残した可能性を否定できないため)。<br/>Lease破棄・worker_generation更新の上、<br/>強制再起動をWorker Managementへ要求する。"]
    WM_TIMEOUT_FORCE --> WM_RESTART
    SRC_PROC --> WM_WATCH
    FORCE_RESTART --> WM_RESTART

    subgraph WM["Worker Management (責任: プロセスの健全性維持)"]
        WM_WATCH["process healthを監視(SRC_PROC専用。<br/>timeoutは既にWM_TIMEOUT_FORCEで再起動確定済みのため、<br/>ここでの生死判定を経由しない)"] --> WM_STATUS{"Workerは正常か"}
        WM_STATUS -->|"No"| WM_RESTART["該当Workerを停止し再起動<br/>(CoreCLR・ModelDb・GameInstanceを再初期化)<br/>(FORCE_RESTART／WM_TIMEOUT_FORCEからの要求もここへ合流。<br/>プロセスが生きていても内容が信用できない場合は再起動する)"]
        WM_STATUS -->|"Yes<br/>(process正常。強制再起動要求も経由していない)"| WORKER_READY_AGAIN2["WorkerをReadyへ戻す"]
        WM_RESTART --> WM_POLICY{"同じWorkItemを再試行するか<br/>(リトライ回数上限あり)"}
        WM_POLICY -->|"Yes<br/>上限未到達"| WM_RETRY["WorkItem状態をRetryingへ遷移させ、<br/>同一WorkItemを別Workerへ再投入<br/>→ mermaid_combat_branch_scheduler_detail.mermaidのQUEUEへ<br/>(Retrying中はCOORD_COLLECTの集約対象に含めない — 下記NOTE_WORKITEM_STATE参照)"]
        WM_POLICY -->|"No<br/>上限到達"| WM_GIVEUP["WorkItem状態をFinalFaultへ確定し、<br/>当該Branchを評価不能Faultとして確定"]
    end

    WORKER_READY_AGAIN --> COORD_COLLECT
    WORKER_READY_AGAIN2 --> COORD_COLLECT
    WM_GIVEUP --> COORD_COLLECT

    subgraph COORD["Search Coordinator (責任: Fault集約・探索継続方針の決定)"]
        COORD_COLLECT["Faultとなった候補を<br/>通常の候補結果と同じ経路で回収<br/>(スコア=最低扱い、または候補集合から除外。<br/>WorkItem状態がFinalFault/FinalSuccessのもののみを対象とする)"]
        COORD_COLLECT --> COORD_CHECK{"この評価境界で有効な候補が<br/>1件以上残っているか<br/>(Retrying中のWorkItemは『まだ残っている』扱いとし、<br/>最終状態が確定するまでこの判定を保留する)"}
        COORD_CHECK -->|"Yes"| CONTINUE_NORMAL["→ mermaid_combat_commit_detail.mermaidへ<br/>通常のDecision Context評価を継続"]
        COORD_CHECK -->|"No<br/>全候補がFault"| ALL_FAULT["Search Evaluation Failureとして確定<br/>(全Branchが評価不能であることのみを意味し、<br/>Main GameInstance自体がFaultしたとは限らない)"]
    end

    ALL_FAULT --> SEARCH_FAIL_LOG["Search Evaluation Failureを<br/>Mainの意思決定層へ報告<br/>(暗黙のDirect fallbackは行わない。<br/>Mainの決定方針の切替は上位の運用判断とする)<br/>→ Search・Snapshot・原因をRL生ログへ記録<br/>→ mermaid_combat_main_loop_detail.mermaidのSEARCH_RESULTが<br/>SearchEvaluationFailureとして受領し、SEARCH_FAIL_HANDLE経由で<br/>CombatAbortedByDecisionFailure(Main Combat Faultとは別種別)へ至る"]

    subgraph MAIN_FAULT_SRC["Main自身のFault (Search Evaluation Failure・Branch Faultとは別経路)"]
        SRC_MAIN_STEP["MainのStepResult自体がFault境界を返した<br/>(mermaid_combat_main_loop_detail.mermaidのSTEP_FAULT_CHECK。<br/>Transition Recordへ追記する前に検出され即座に遷移する)"]
        SRC_MAIN_INVARIANT["Main不変性検証の失敗(deterministic violation)<br/>(mermaid_combat_commit_detail.mermaidのINVARIANT_VIOLATION。<br/>探索中にMainのState Identityが変化した、または<br/>構造的に想定外の状態になった場合)"]
        SRC_MAIN_STEP --> MAIN_COMBAT_FAULT["Main Combat Fault<br/>Fault・Snapshot・RNG・直前ActionをRL生ログへ記録"]
        SRC_MAIN_INVARIANT --> MAIN_COMBAT_FAULT
    end

    MAIN_COMBAT_FAULT --> MAIN_FAULT_LOG["→ mermaid_combat_main_loop_detail.mermaidのFAULT_OUTへ<br/>Combat自体の異常終了として扱う"]

    NOTE_MAIN_INVARIANT_SEPARATE["設計注記: Main不変性違反(SRC_MAIN_INVARIANT)は、Branch Worker側の<br/>Fault(validation rejection/replay mismatch/post-teardown Restore<br/>failure/action fault)とは性質が異なり、Worker再利用判断(FAULT_TYPE)を<br/>経由しない。Main正本の整合性異常として、常にMain Combat Faultへ直行する。"]
    NOTE_MAIN_INVARIANT_SEPARATE -.-> SRC_MAIN_INVARIANT

    %% 設計注記: Continuation深さ上限
    NOTE_DEPTH_CAP["設計注記: 同一Decision Context系列内(直前のStable/Terminalから<br/>連鎖するPending)のContinuation連鎖回数には上限を設ける<br/>(現行実装のMAX_CONTINUATION_STEPS=50に相当する概念を、<br/>Decision Context系列内の連鎖選択上限として明文化する。<br/>具体的な数値は別途決定する)。<br/>上限到達時は当該Decision Contextをこの図のSRC_DEPTH経路でFault扱いとする<br/>(rl_combat_rough_worker_pool_review_20260801_v2.md §2-B参照)。"]
    NOTE_DEPTH_CAP -.-> SRC_DEPTH

    %% 設計注記: 暗黙fallbackの禁止
    NOTE_NO_FALLBACK["設計注記: Worker/Branchの障害を理由に、Search Coordinatorが<br/>暗黙にDirect方式へ切り替えることはしない<br/>(参考: deprecated/mermaid_combat_target_worker_pool.mermaidの<br/>REJECT_TASK方針と同趣旨。当該図は現在deprecatedであり、<br/>本方針は本図自体が正本として定義するものである)。"]
    NOTE_NO_FALLBACK -.-> ALL_FAULT

    %% 設計注記: Training担当向けログ/Result schema
    NOTE_LOG_SCHEMA["設計注記(Training担当接続): 全てのBranchResult/DecisionLogは<br/>次のフィールドを必須とする共通schemaに従う。<br/>・status = success | pruned | validation_rejected | replay_mismatch |<br/>  action_fault | timeout | coverage_failed | diagnostic_only<br/>・root_action_key (この探索呼び出しの起点における最初の1手の識別子)<br/>・hypothesis_id (標準/診断タグ含む。Noneも明示的な値として記録)<br/>・plan_path (この結果に至ったTransition Record列)<br/>・replay_prefix_digest (Replay Prefix内容のハッシュ。再現性検証用)<br/>これにより、Training担当は『低評価で負けた』候補と『Fault/coverage不足で<br/>比較対象外』だった候補を区別でき、誤った教師信号を学習データへ<br/>混入させることを防げる。"]
    NOTE_LOG_SCHEMA -.-> COORD_COLLECT
    NOTE_LOG_SCHEMA -.-> MAIN_COMBAT_FAULT

    %% 設計注記: WorkItem状態モデル
    NOTE_WORKITEM_STATE["設計注記: 各WorkItemは Running(実行中) / Retrying(再試行待ち) /<br/>FinalSuccess(成功確定) / FinalFault(失敗確定) のいずれかの状態を持つ。<br/>mermaid_combat_commit_detail.mermaidのIN(Decision Context結果の集約対象)は<br/>FinalSuccess/FinalFaultのみとし、Retrying中のWorkItemを先に<br/>最低スコアとして集約してしまい、後から成功結果が返って<br/>二重集計になることを防ぐ(非同期実装での取り違えを避けるための明示)。"]
    NOTE_WORKITEM_STATE -.-> WM_RETRY
    NOTE_WORKITEM_STATE -.-> COORD_COLLECT

    %% 設計注記: Fault種別ごとの再利用方針のまとめ
    NOTE_REUSE_TABLE["設計注記(まとめ): Fault種別ごとの既定方針(Emulator契約上の必須事項と<br/>初期実装の運用ポリシーを区別する)<br/>・validation rejection → 再利用可(再起動不要。非破壊的照会のため<br/>  Emulator契約上もGameInstance未変更であることが保証されている)<br/>・replay mismatch → 再起動/強制再初期化(運用ポリシーとしての安全側の既定)<br/>・post-teardown Restore failure → Workerをquarantineし、<br/>  初期運用ではWorker Process再起動(運用ポリシー。Emulator契約上は<br/>  clean Restore成功による回復可能性があり、必須の再起動ではない)<br/>・action fault → 再起動/強制再初期化(運用ポリシーとしての安全側の既定。<br/>  Emulator側の例外分類整備後に緩和を検討)<br/>replay mismatch・post-teardown Restore failure・action faultの<br/>既定を緩和できるかどうかは、RestoreSnapshotJsonが真に完全な<br/>状態リセットを提供することの実測的な検証(決定性テスト等)に<br/>依存する未解決事項である。"]
    NOTE_REUSE_TABLE -.-> FAULT_TYPE
